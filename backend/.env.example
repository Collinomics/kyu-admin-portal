APP_NAME="Kyambogo PCS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
PCS_SHOW_DEVELOPMENT_OTP=false

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
NVIDIA_CHAT_MODELS=openai/gpt-oss-20b,minimaxai/minimax-m3,moonshotai/kimi-k3,meta/muse-glimmer-30b

# Production credential rotation. Use an EC2 instance role; never enter AWS
# access keys in the portal. The named secret must be pre-created and the role
# restricted to Describe/Get/PutSecretValue for that exact secret ARN.
AWS_SECRETS_MANAGER_ENABLED=false
AWS_SECRETS_MANAGER_REGION=${AWS_DEFAULT_REGION}
AWS_SECRETS_MANAGER_PROFILE=
AWS_SECRETS_MANAGER_CACHE_SECONDS=300
AWS_SECRET_NVIDIA_API_KEY_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=your-session-pooler-host.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-reference
DB_PASSWORD=
DB_SSLMODE=require
DB_SCHEMA=pcs

# Created by `php artisan pcs:create-runtime-roles`. Never expose or commit.
SUPABASE_ADMIN_DB_USERNAME=
SUPABASE_ADMIN_DB_PASSWORD=
PCS_RUNTIME_DB_USERNAME=
PCS_RUNTIME_DB_PASSWORD=
AI_RUNTIME_DB_USERNAME=
AI_RUNTIME_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Governed AI knowledge ingestion. The antivirus command must accept
# `--no-summary --infected <path>` (ClamAV clamscan is supported).
KNOWLEDGE_ANTIVIRUS_BINARY=
KNOWLEDGE_ANTIVIRUS_DATABASE=
KNOWLEDGE_ANTIVIRUS_TIMEOUT=240
KNOWLEDGE_MAX_UPLOAD_KB=12288
KNOWLEDGE_MAX_ARCHIVE_ENTRIES=5000
KNOWLEDGE_MAX_UNCOMPRESSED_BYTES=104857600
KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
KNOWLEDGE_MAX_CSV_ROWS=20000
KNOWLEDGE_MAX_CSV_COLUMNS=100
KNOWLEDGE_CHUNK_CHARACTERS=3000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Used once when seeding a fresh environment. Set a strong password; never
# rely on a password committed to source control.
PCS_BOOTSTRAP_ADMIN_EMAIL=sysadmin@kyu.ac.ug
PCS_BOOTSTRAP_ADMIN_PASSWORD=
