[Unit]
Description=Kyambogo PCS Laravel queue worker
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/kyu-portal/backend
ExecStart=/usr/bin/php artisan queue:work --queue=knowledge,default --sleep=1 --tries=3 --timeout=420 --max-time=3600 --memory=256
Restart=always
RestartSec=5
Nice=10
OOMScoreAdjust=500
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
